# 제주 데이터 길잡이 설정 예시. 이 파일을 `.env`로 복사한 뒤 값을 채우세요.

# --- AI 모델(OpenAI 호환 Chat Completions + 도구 호출을 지원하는 서버) ---
# 예1) OpenAI          LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=<모델명>
# 예2) Google Gemini   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=<모델명>
# 예3) 센터 PC 로컬    LLM_BASE_URL=http://127.0.0.1:11434/v1 (Ollama)   LLM_MODEL=<도구 호출 지원 모델>
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- 제주데이터허브 API 데이터용 프로젝트 키(선택) ---
# 없으면 파일(FILE) 데이터 670여 종만 사용합니다. 발급 방법은 docs/사용자_매뉴얼.md 참고.
JEJU_DATAHUB_PROJECT_KEY=

# --- 제주빅데이터센터 방문 데이터 폴더(선택, 센터 PC 전용) ---
# 센터에서 제공받은 CSV/XLSX를 이 폴더에 두면 '센터 데이터'로 분석할 수 있습니다.
CENTER_DATA_DIR=

# --- 기타(선택) ---
# DATA_DIR=./data          # 카탈로그·다운로드 캐시
# OUTPUT_DIR=./outputs     # 답변별 보고서·표·차트·재현 코드
# AGENT_MAX_STEPS=14       # 질문 하나당 AI가 도구를 쓰는 최대 횟수
